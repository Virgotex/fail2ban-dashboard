# Copy to hub/.env — NEVER commit .env

# ─── Network ─────────────────────────────────────────────────────────────
HUB_PORT=3100
# Keep 127.0.0.1 — you reach the hub over an SSH tunnel from your laptop.
HUB_BIND_ADDRESS=127.0.0.1
NODE_ENV=production

# ─── Auth ────────────────────────────────────────────────────────────────
# The key the browser sends to the hub. This is the ONLY key that reaches a
# browser; agent keys stay in servers.json, server-side. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_API_SECRET=change_this_to_a_random_secret_string

# ─── Registry ────────────────────────────────────────────────────────────
# Path to the JSON list of agents. Copy servers.example.json to servers.json
# and fill in each server's tunnel baseUrl + that agent's own API_SECRET.
# HUB_SERVERS_FILE=/opt/fail2ban-dashboard/hub/servers.json

# Per-agent request timeout (ms). One slow/dead agent won't stall the fleet
# view beyond this — it degrades to an "offline" row.
# AGENT_TIMEOUT_MS=8000

# ─── Tunnels ─────────────────────────────────────────────────────────────
# Who opens the SSH tunnels to the agents?
#
#   false (default) — something else does: the systemd units created by
#                     install-tunnels.sh. Right for a hub running on a server.
#   true            — this process does. It spawns one `ssh -N -L` per server
#                     that has an "ssh" field, restarts them with backoff, and
#                     kills them on exit. Right for running the hub on your own
#                     machine: no root, no systemd, just `npm start`.
# HUB_MANAGE_TUNNELS=false

# The port agents listen on inside their own hosts (the far end of the tunnel).
# AGENT_PORT=3001

# Override the ssh binary used for managed tunnels — e.g. autossh, or a full
# path on macOS/Windows.
# HUB_SSH_BIN=ssh

# ─── Load on the monitored servers ───────────────────────────────────────
# These two settings decide how hard the hub leans on your fleet.
#
# How many agents are queried simultaneously during a fleet fan-out. Lower
# means a slower overview but a gentler estate; the default is deliberately
# conservative for production.
# HUB_FANOUT_CONCURRENCY=4
#
# How long a computed fleet overview is reused. Every viewer shares it, so
# with the default each agent sees at most one round of queries per 10s no
# matter how many operators have the dashboard open. Raise it for large
# fleets. 0 disables caching (every request re-queries every agent).
# HUB_OVERVIEW_TTL_MS=10000

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
