# Copy to hub/.env — NEVER commit .env

# ─── Network ─────────────────────────────────────────────────────────────
HUB_PORT=3100
# Keep 127.0.0.1 — reach the hub over an SSH tunnel, same as a single agent.
HUB_BIND_ADDRESS=127.0.0.1
NODE_ENV=production

# ─── Auth ────────────────────────────────────────────────────────────────
# The key the browser sends to the hub. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HUB_API_SECRET=change_this_to_a_random_secret_string

# ─── Registry ────────────────────────────────────────────────────────────
# Path to the JSON list of agents. Copy servers.example.json to servers.json
# and fill in each server's tunnel baseUrl + that agent's own API_SECRET.
# HUB_SERVERS_FILE=/opt/fail2ban-dashboard/hub/servers.json

# Per-agent request timeout (ms). One slow/dead agent won't stall the fleet
# view beyond this.
# AGENT_TIMEOUT_MS=8000

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
