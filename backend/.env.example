# Copy this to .env and fill in your values
# NEVER commit .env to git

# ─── Network ─────────────────────────────────────────────────────────────
PORT=3001
# Where the HTTP server binds. Keep 127.0.0.1 for laptop use. Set to 0.0.0.0
# inside a container (the container's exposed port / NetworkPolicy handles
# external reachability).
BIND_ADDRESS=127.0.0.1
NODE_ENV=development

# Allowed origin for CORS — only used when the backend is API-only. When
# the backend serves the built SPA from ../frontend/dist this is ignored.
ALLOWED_ORIGIN=http://localhost:5173

# trust proxy — set when you're behind a non-loopback reverse proxy so
# express-rate-limit and req.ip see the real client. See
# https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=1

# ─── Authentication ──────────────────────────────────────────────────────
# Default: API-key mode. Suitable for laptop / single-user use only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=change_this_to_a_random_secret_string

# OIDC mode (production / multi-user). When OIDC_ENABLED=true the backend
# requires a logged-in session for all API routes; writes additionally
# require membership of OIDC_REQUIRED_GROUP if set.
OIDC_ENABLED=false
# OIDC_ISSUER_BASE_URL=https://idp.example.com/realms/company
# OIDC_CLIENT_ID=fail2ban-dashboard
# OIDC_CLIENT_SECRET=
# Public URL where users will reach the dashboard (must match the redirect
# URI configured at the IdP: OIDC_BASE_URL + /callback).
# OIDC_BASE_URL=https://fail2ban.example.com
# Long random string used to encrypt the session cookie. Same generator
# as API_SECRET above.
# OIDC_SECRET=
# Group / role claim name (default 'groups'). Adjust to match your IdP —
# Keycloak: 'groups', Okta: 'groups', Azure AD: 'roles', Auth0: a namespaced
# claim like 'https://example.com/groups'.
# OIDC_GROUPS_CLAIM=groups
# If set, only users whose group claim contains this value can ban/unban.
# Leave empty to let any authenticated user perform writes.
# OIDC_REQUIRED_GROUP=fail2ban-admins

# ─── Fail2ban paths ──────────────────────────────────────────────────────
FAIL2BAN_SOCKET=/var/run/fail2ban/fail2ban.sock
FAIL2BAN_LOG=/var/log/fail2ban.log

# Whether to wrap fail2ban-client in sudo. See docs/SECURITY.md for the
# matching sudoers rule. Set USE_SUDO=false if the dashboard runs as root
# or under a user already in the fail2ban group.
# USE_SUDO=true

# ─── Performance limits ──────────────────────────────────────────────────
LOG_MAX_LINES=200
# Max bytes read from the tail of fail2ban.log per request (defends against
# pathologically large logs).
# LOG_MAX_BYTES=2097152
# Same for /var/log/auth.log and /var/log/syslog (IP investigation).
# AUTH_MAX_BYTES=5242880

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Geo lookup ──────────────────────────────────────────────────────────
# Set GEO_LOOKUP=false to disable IP-to-country resolution entirely (no
# outbound requests). When enabled, results are cached for GEO_TTL_MS.
# GEO_LOOKUP=true
# GEO_TTL_MS=3600000
