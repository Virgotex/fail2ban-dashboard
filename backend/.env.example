# Agent config — copy this to .env and fill in your values.
# NEVER commit .env to git.
#
# This is the per-server AGENT: an API with no UI. The hub is its only client.

# ─── Network ─────────────────────────────────────────────────────────────
PORT=3001
# Keep 127.0.0.1. The hub reaches this agent over an SSH tunnel, so the port
# never needs to be open on the network. Set to 0.0.0.0 only inside a
# container whose network policy handles reachability.
BIND_ADDRESS=127.0.0.1
NODE_ENV=production

# trust proxy — set when something non-loopback fronts this agent, so
# express-rate-limit and req.ip see the real client. See
# https://expressjs.com/en/guide/behind-proxies.html
# TRUST_PROXY=1

# ─── Authentication ──────────────────────────────────────────────────────
# This agent's own key. It must match the "apiKey" for this server in the
# hub's servers.json — and it should differ from every other agent's key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=change_this_to_a_random_secret_string

# ─── Fail2ban paths ──────────────────────────────────────────────────────
FAIL2BAN_SOCKET=/var/run/fail2ban/fail2ban.sock
FAIL2BAN_LOG=/var/log/fail2ban.log

# System logs consulted (besides fail2ban.log) when investigating an IP, for the
# usernames and ports it tried. Comma-separated; unreadable ones are skipped
# (they need the agent user in `adm`). Set to empty to consult none.
# AUTH_LOG_PATHS=/var/log/auth.log,/var/log/secure,/var/log/syslog

# Whether to wrap fail2ban-client in sudo. See docs/SECURITY.md for the
# matching sudoers rule. Set USE_SUDO=false if the agent runs as root
# or under a user already in the fail2ban group.
# USE_SUDO=true

# ─── Load protection ─────────────────────────────────────────────────────
# The hub polls this agent continuously. These TTLs decide how much of that
# polling actually reaches fail2ban: within the window, repeated reads are
# served from memory and concurrent reads are coalesced into one call.
# Raise them if you monitor many servers or run many jails; set to 0 to
# disable caching entirely.
# AGENT_CACHE_TTL_MS=5000
# Log parsing (logs, reports, IP investigation) re-reads files from disk.
# LOG_CACHE_TTL_MS=10000

# ─── Performance limits ──────────────────────────────────────────────────
LOG_MAX_LINES=200
# Max bytes read from the tail of fail2ban.log per request (defends against
# pathologically large logs).
# LOG_MAX_BYTES=2097152
# Same for /var/log/auth.log and /var/log/syslog (IP investigation).
# AUTH_MAX_BYTES=5242880
# Budget for the backward-looking features: the 7-day trend, per-jail totals and
# an IP's timeline. These read rotated logs too (fail2ban.log.1, .2.gz, …),
# because after a rotation the live file holds almost nothing and every one of
# them would otherwise report zero. Larger = more history, more I/O per cache
# miss; results are cached for LOG_CACHE_TTL_MS. Lower it on a very busy host.
# HISTORY_MAX_BYTES=16777216

# ─── Rate limiting ───────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Geo lookup ──────────────────────────────────────────────────────────
# Set GEO_LOOKUP=false to disable IP-to-country resolution entirely (no
# outbound requests from this server). When enabled, results are cached for
# GEO_TTL_MS.
# GEO_LOOKUP=true
# GEO_TTL_MS=3600000
