# Copy this to .env and fill in your values
# NEVER commit .env to git

PORT=3001
NODE_ENV=development

# Secret key for signing API tokens (change this to a long random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET=change_this_to_a_random_secret_string

# Allowed origin for CORS (your React frontend)
ALLOWED_ORIGIN=http://localhost:5173

# Fail2ban socket path (default on most Linux systems)
FAIL2BAN_SOCKET=/var/run/fail2ban/fail2ban.sock

# Fail2ban log file path
FAIL2BAN_LOG=/var/log/fail2ban.log

# Max log lines to return per request
LOG_MAX_LINES=200

# Rate limiting: max requests per window
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
