# Copy this to .env.local — Vite injects VITE_ prefixed vars into the browser
# Must match API_SECRET in backend/.env exactly.
# All API and WebSocket traffic goes through the Vite dev proxy (vite.config.js)
# in dev and through your reverse proxy in production, so no API URL is needed.
VITE_API_KEY=change_this_to_a_random_secret_string
