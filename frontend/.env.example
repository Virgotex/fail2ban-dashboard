# Copy this to .env.local — Vite injects VITE_ prefixed vars into the browser.
#
# This must match HUB_API_SECRET in hub/.env — the browser only ever talks to
# the hub. Agent keys live in hub/servers.json and never reach the browser.
#
# All API traffic goes through the Vite dev proxy (vite.config.js) in dev, and
# is served same-origin by the hub in production, so no API URL is needed.
VITE_API_KEY=change_this_to_a_random_secret_string
